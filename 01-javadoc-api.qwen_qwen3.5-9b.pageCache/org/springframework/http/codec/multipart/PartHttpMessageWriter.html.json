      "source": "<span class=\"description-from-type-label\">Description copied from interface: <code><a href=\"../HttpMessageWriter.html#canWrite(org.springframework.core.ResolvableType,org.springframework.http.MediaType)\">HttpMessageWriter</a></code></span>",
