      "count": 2
    },
    {
      "source": "Create a new instance of the <code>JdkClientHttpRequestFactory</code>\nwith a default <a class=\"external-link\" href=\"https://docs.oracle.com/en/java/javase/17/docs/api/java.net.http/java/net/http/HttpClient.html\" title=\"class or interface in java.net.http\"><code>HttpClient</code></a>.",
