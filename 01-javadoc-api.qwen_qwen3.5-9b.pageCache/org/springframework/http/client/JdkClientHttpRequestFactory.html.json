      "count": 1
    },
    {
      "source": "<span class=\"description-from-type-label\">Description copied from interface: <code><a href=\"ClientHttpRequestFactory.html#createRequest(java.net.URI,org.springframework.http.HttpMethod)\">ClientHttpRequestFactory</a></code></span>",
