    {
      "source": "<code><a href=\"../LoadTimeWeaver.html#getInstrumentableClassLoader()\">getInstrumentableClassLoader</a></code> in interface <code><a href=\"../LoadTimeWeaver.html\" title=\"interface in org.springframework.instrument.classloading\">LoadTimeWeaver</a></code>",
