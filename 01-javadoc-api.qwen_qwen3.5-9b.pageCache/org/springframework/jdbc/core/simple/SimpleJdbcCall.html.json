    {
      "source": "<code>dataSource</code> - the <code>DataSource</code> to use",
      "translation": "<code>dataSource</code> - 要使用的 <code>DataSource</code>",
      "count": 2
    },
    {
      "source": "<code>procedureName</code> - the name of the stored procedure",
      "translation": "<code>procedureName</code> - 存储过程名称",
      "count": 2
    },
    {
      "source": "<code>functionName</code> - the name of the stored function",
      "translation": "<code>functionName</code> - 存储函数的名称",
      "count": 2
    },
    {
      "source": "<code>schemaName</code> - the name of the schema",
      "translation": "<code>schemaName</code> - 模式的名称",
      "count": 2
    },
    {
      "source": "<code>catalogName</code> - the catalog or package name",
      "translation": "<code>catalogName</code> - 目录或包名称",
      "count": 2
    },
    {
      "source": "<code>sqlParameters</code> - the parameters to use",
      "translation": "<code>sqlParameters</code> - 要使用的参数",
      "count": 2
    },
    {
      "source": "<code>parameterName</code> - the name of the returned results and/or the name of the ref cursor parameter",
      "translation": "<code>parameterName</code> - 返回结果和/或引用游标参数的名称",
      "count": 2
    },
    {
      "source": "<code>rowMapper</code> - the RowMapper implementation that will map the data returned for each row",
      "translation": "<code>rowMapper</code> - 用于映射每行返回数据的 RowMapper 实现。",
      "count": 2
    },
    {
      "source": "<code>args</code> - optional array containing the in parameter values to be used in the call.\nParameter values must be provided in the same order as the parameters are defined\nfor the stored procedure.",
      "translation": "`args` - 可选数组，包含要在调用中使用的输入参数值。\n必须按照存储过程中定义参数的顺序提供参数值。",
      "count": 2
    },
    {
      "source": "<code>parameterSource</code> - the SqlParameterSource containing the parameter values to be used in the call",
      "translation": "<code>parameterSource</code> - 包含要在调用中使用的参数值的 SqlParameterSource",
      "count": 2
    },
    {
      "source": "Thomas Risberg, Stephane Nicoll",
      "translation": "Thomas Risberg, Stephane Nicoll",
      "count": 2
    },
    {
      "source": "Used to specify when a ResultSet is returned by the stored procedure and you want it\nmapped by a <a href=\"../RowMapper.html\" title=\"interface in org.springframework.jdbc.core\"><code>RowMapper</code></a>.",
      "translation": "用于指定存储过程返回的 ResultSet 何时被映射，且您希望它由一个<a href=\"../RowMapper.html\" title=\"interface in org.springframework.jdbc.core\"><code>RowMapper</code></a>进行映射。",
      "count": 1
    },
    {
      "source": "Specify one or more parameters if desired.",
      "translation": "如有需要，请指定一个或多个参数。",
      "count": 1
    },
    {
      "source": "Optionally, specify the name of the catalog that contains the stored procedure.",
      "translation": "可选地，指定包含存储过程的目录名称。",
      "count": 1
    },
