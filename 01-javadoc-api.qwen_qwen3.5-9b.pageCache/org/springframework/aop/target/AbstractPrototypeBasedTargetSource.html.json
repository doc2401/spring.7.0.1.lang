      "translation": "<span class=\"description-from-type-label\">描述从类复制：<code><a href=\"AbstractBeanFactoryBasedTargetSource.html#setBeanFactory(org.springframework.beans.factory.BeanFactory)\">AbstractBeanFactoryBasedTargetSource</a></code></span>",
      "count": 1
