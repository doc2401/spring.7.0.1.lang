      "count": 2
    },
    {
      "source": "Return a code to use to resolve the problem \"detail\" for this exception\nthrough a <a href=\"../../context/MessageSource.html\" title=\"interface in org.springframework.context\"><code>MessageSource</code></a>.",
      "translation": "通过一个<a href=\"../../context/MessageSource.html\" title=\"interface in org.springframework.context\"><code>MessageSource</code></a>来返回用于解决此异常中\"detail\"问题的代码。",
      "count": 2
