      "translation": "<span class=\"description-from-type-label\">描述从接口复制：<code><a href=\"../support/HandlerMethodArgumentResolver.html#resolveArgument(org.springframework.core.MethodParameter,org.springframework.web.method.support.ModelAndViewContainer,org.springframework.web.context.request.NativeWebRequest,org.springframework.web.bind.support.WebDataBinderFactory)\">HandlerMethodArgumentResolver</a></code></span>",
      "count": 1
