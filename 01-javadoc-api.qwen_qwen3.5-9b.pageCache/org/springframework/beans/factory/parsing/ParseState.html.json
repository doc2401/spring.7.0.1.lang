      "count": 3
    },
    {
      "source": "Add a new <a href=\"ParseState.Entry.html\" title=\"interface in org.springframework.beans.factory.parsing\"><code>ParseState.Entry</code></a> to the <a class=\"external-link\" href=\"https://docs.oracle.com/en/java/javase/17/docs/api/java.base/java/util/ArrayDeque.html\" title=\"class or interface in java.util\"><code>ArrayDeque</code></a>.",
