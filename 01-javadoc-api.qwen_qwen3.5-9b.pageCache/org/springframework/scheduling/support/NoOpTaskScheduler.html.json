      "count": 1
    },
    {
      "source": "Schedule the given <a class=\"external-link\" href=\"https://docs.oracle.com/en/java/javase/17/docs/api/java.base/java/lang/Runnable.html\" title=\"class or interface in java.lang\"><code>Runnable</code></a>, invoking it at the specified execution time.",
      "translation": "调度给定的 <a class=\"external-link\" href=\"https://docs.oracle.com/en/java/javase/17/docs/api/java.base/java/lang/Runnable.html\" title=\"class or interface in java.lang\"><code>Runnable</code></a>，在指定的执行时间调用它。",
      "count": 1
    },
    {
      "source": "Schedule the given <a class=\"external-link\" href=\"https://docs.oracle.com/en/java/javase/17/docs/api/java.base/java/lang/Runnable.html\" title=\"class or interface in java.lang\"><code>Runnable</code></a>, invoking it whenever the trigger\nindicates a next execution time.",
      "translation": "调度给定的 <a class=\"external-link\" href=\"https://docs.oracle.com/en/java/javase/17/docs/api/java.base/java/lang/Runnable.html\" title=\"class or interface in java.lang\"><code>Runnable</code></a>，每当触发器指示下一个执行时间时调用它。",
      "count": 1
    },
    {
      "source": "Schedule the given <a class=\"external-link\" href=\"https://docs.oracle.com/en/java/javase/17/docs/api/java.base/java/lang/Runnable.html\" title=\"class or interface in java.lang\"><code>Runnable</code></a>, starting as soon as possible and\ninvoking it with the given period.",
      "translation": "安排给定的 <a class=\"external-link\" href=\"https://docs.oracle.com/en/java/javase/17/docs/api/java.base/java/lang/Runnable.html\" title=\"class or interface in java.lang\"><code>Runnable</code></a>，尽快开始并以其给定周期进行调用。",
      "count": 1
    },
    {
      "source": "Schedule the given <a class=\"external-link\" href=\"https://docs.oracle.com/en/java/javase/17/docs/api/java.base/java/lang/Runnable.html\" title=\"class or interface in java.lang\"><code>Runnable</code></a>, invoking it at the specified execution time\nand subsequently with the given period.",
      "translation": "调度给定的 <a class=\"external-link\" href=\"https://docs.oracle.com/en/java/javase/17/docs/api/java.base/java/lang/Runnable.html\" title=\"class or interface in java.lang\"><code>Runnable</code></a>，在指定的执行时间调用它，随后以给定的周期进行调用。",
      "count": 1
    },
    {
      "source": "Schedule the given <a class=\"external-link\" href=\"https://docs.oracle.com/en/java/javase/17/docs/api/java.base/java/lang/Runnable.html\" title=\"class or interface in java.lang\"><code>Runnable</code></a>, starting as soon as possible and invoking it with\nthe given delay between the completion of one execution and the start of the next.",
      "translation": "调度给定的 <a class=\"external-link\" href=\"https://docs.oracle.com/en/java/javase/17/docs/api/java.base/java/lang/Runnable.html\" title=\"class or interface in java.lang\"><code>Runnable</code></a>，尽可能早地开始执行，并在每次执行完成与下一次启动之间使用给定的延迟间隔。",
      "count": 1
    },
    {
      "source": "Schedule the given <a class=\"external-link\" href=\"https://docs.oracle.com/en/java/javase/17/docs/api/java.base/java/lang/Runnable.html\" title=\"class or interface in java.lang\"><code>Runnable</code></a>, invoking it at the specified execution time\nand subsequently with the given delay between the completion of one execution\nand the start of the next.",
      "translation": "调度给定的 <a class=\"external-link\" href=\"https://docs.oracle.com/en/java/javase/17/docs/api/java.base/java/lang/Runnable.html\" title=\"class or interface in java.lang\"><code>Runnable</code></a>，在指定的执行时间调用它，随后以给定的延迟间隔，在一次执行完成和下一次启动之间重复调用。",
      "count": 1
    },
    {
      "source": "a <a class=\"external-link\" href=\"https://docs.oracle.com/en/java/javase/17/docs/api/java.base/java/util/concurrent/ScheduledFuture.html\" title=\"class or interface in java.util.concurrent\"><code>ScheduledFuture</code></a> representing pending execution of the task,\nor <code>null</code> if the given Trigger object never fires (i.e. returns\n<code>null</code> from <a href=\"../Trigger.html#nextExecution(org.springframework.scheduling.TriggerContext)\"><code>Trigger.nextExecution(TriggerContext)</code></a>)",
      "translation": "一个代表任务待执行状态的<a class=\"external-link\" href=\"https://docs.oracle.com/en/java/javase/17/docs/api/java.base/java/util/concurrent/ScheduledFuture.html\" title=\"class or interface in java.util.concurrent\"><code>ScheduledFuture</code></a>，或者如果给定的 Trigger 对象从未触发（即从<a href=\"../Trigger.html#nextExecution(org.springframework.scheduling.TriggerContext)\"><code>Trigger.nextExecution(TriggerContext)</code></a>返回<code>null</code>），则为<code>null</code>。",
      "count": 1
    },
