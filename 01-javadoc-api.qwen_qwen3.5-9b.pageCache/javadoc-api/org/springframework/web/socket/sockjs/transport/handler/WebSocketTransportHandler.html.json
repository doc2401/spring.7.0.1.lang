    {
      "source": "Also implements <a href=\"../../../server/HandshakeHandler.html\" title=\"interface in org.springframework.web.socket.server\"><code>HandshakeHandler</code></a> to support raw WebSocket communication at\nSockJS URL \"/websocket\".",
      "translation": "还实现了<a href=\"../../../server/HandshakeHandler.html\" title=\"interface in org.springframework.web.socket.server\"><code>HandshakeHandler</code></a>以支持 SockJS 路径\"/websocket\"处的原始 WebSocket 通信。",
      "count": 2
    },
    {
      "source": "<span class=\"description-from-type-label\">Description copied from interface: <code><a href=\"../../../server/HandshakeHandler.html#doHandshake(org.springframework.http.server.ServerHttpRequest,org.springframework.http.server.ServerHttpResponse,org.springframework.web.socket.WebSocketHandler,java.util.Map)\">HandshakeHandler</a></code></span>",
      "translation": "<span class=\"description-from-type-label\">描述从接口复制：<code><a href=\"../../../server/HandshakeHandler.html#doHandshake(org.springframework.http.server.ServerHttpRequest,org.springframework.http.server.ServerHttpResponse,org.springframework.web.socket.WebSocketHandler,java.util.Map)\">HandshakeHandler</a></code></span>",
      "count": 2
    },
    {
      "source": "Handle the given request and delegate messages to the provided\n<a href=\"../../../WebSocketHandler.html\" title=\"interface in org.springframework.web.socket\"><code>WebSocketHandler</code></a>.",
      "translation": "将给定的请求委托到提供的 <a href=\"../../../WebSocketHandler.html\" title=\"interface in org.springframework.web.socket\"><code>WebSocketHandler</code></a> 处理消息。",
      "count": 2
    },
    {
      "source": "Check whether the type of the given session matches the transport type\nof this <code>TransportHandler</code> where session id and the transport type\nare extracted from the SockJS URL.",
      "translation": "检查给定会话的类型是否与此 `<code>TransportHandler</code>` 的传输类型匹配，其中会话 ID 和传输类型是从 SockJS URL 中提取的。",
      "count": 2
    },
    {
      "source": "Create a new SockJS session.",
      "translation": "创建一个新的 SockJS 会话。",
      "count": 2
    },
    {
      "source": "Initiate the handshake.",
      "translation": "发起握手。",
      "count": 2
    },
    {
      "source": "Return the transport type supported by this handler.",
      "translation": "返回此处理器支持的传输类型。",
      "count": 2
    },
    {
      "source": "<code><a href=\"../TransportHandler.html#getTransportType()\">getTransportType</a></code> in interface <code><a href=\"../TransportHandler.html\" title=\"interface in org.springframework.web.socket.sockjs.transport\">TransportHandler</a></code>",
      "translation": "`<code><a href=\"../TransportHandler.html#getTransportType()\">getTransportType</a></code>` 在接口 `<code><a href=\"../TransportHandler.html\" title=\"interface in org.springframework.web.socket.sockjs.transport\">TransportHandler</a></code>` 中",
      "count": 2
    },
