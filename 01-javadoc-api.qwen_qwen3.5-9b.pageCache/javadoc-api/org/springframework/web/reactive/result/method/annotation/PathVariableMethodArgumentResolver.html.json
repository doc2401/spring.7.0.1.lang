    {
      "source": "Create a new <a href=\"PathVariableMethodArgumentResolver.html\" title=\"class in org.springframework.web.reactive.result.method.annotation\"><code>PathVariableMethodArgumentResolver</code></a>.",
      "translation": "创建一个新的<a href=\"PathVariableMethodArgumentResolver.html\" title=\"class in org.springframework.web.reactive.result.method.annotation\"><code>PathVariableMethodArgumentResolver</code></a>。",
      "count": 3
