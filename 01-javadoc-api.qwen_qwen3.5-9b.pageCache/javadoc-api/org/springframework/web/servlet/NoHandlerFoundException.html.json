    {
      "source": "<ul class=\"tag-list-long\">\n<li><a href=\"DispatcherServlet.html#noHandlerFound(jakarta.servlet.http.HttpServletRequest,jakarta.servlet.http.HttpServletResponse)\"><code>DispatcherServlet.noHandlerFound(HttpServletRequest, HttpServletResponse)</code></a></li>\n<li><a href=\"../../../../serialized-form.html#org.springframework.web.servlet.NoHandlerFoundException\">Serialized Form</a></li>\n</ul>",
      "translation": "<ul class=\"tag-list-long\">\n<li><a href=\"DispatcherServlet.html#noHandlerFound(jakarta.servlet.http.HttpServletRequest,jakarta.servlet.http.HttpServletResponse)\"><code>DispatcherServlet.noHandlerFound(HttpServletRequest, HttpServletResponse)</code></a></li>\n<li><a href=\"../../../../serialized-form.html#org.springframework.web.servlet.NoHandlerFoundException\">Serialized Form</a></li>\n</ul>",
