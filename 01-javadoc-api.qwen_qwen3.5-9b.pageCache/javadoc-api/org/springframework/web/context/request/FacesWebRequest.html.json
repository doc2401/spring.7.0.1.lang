    {
      "source": "<code>requiredType</code> - the desired type of request object",
      "translation": "<code>requiredType</code> - 请求对象的期望类型",
      "count": 2
    },
    {
      "source": "the matching request object, or <code>null</code> if none\nof that type is available",
      "translation": "匹配请求对象，或者如果不可用则返回<code>null</code>。",
      "count": 2
    },
    {
