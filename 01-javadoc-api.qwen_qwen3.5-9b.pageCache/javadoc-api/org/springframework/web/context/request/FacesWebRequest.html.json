      "count": 1
    },
    {
      "source": "Return the request parameter of the given name, or <code>null</code> if none.",
      "translation": "返回给定名称的请求参数，如果没有则返回 <code>null</code>。",
      "count": 1
    },
    {
      "source": "Return the request parameter values for the given parameter name,\nor <code>null</code> if none.",
      "translation": "返回给定参数名的请求参数值，如果没有则返回 `<code>null</code>`。",
      "count": 1
    },
    {
      "source": "Check whether the requested resource has been modified given the\nsupplied last-modified timestamp (as determined by the application).",
      "translation": "检查根据应用程序确定的 supplied last-modified 时间戳，请求的资源是否已修改。",
      "count": 1
