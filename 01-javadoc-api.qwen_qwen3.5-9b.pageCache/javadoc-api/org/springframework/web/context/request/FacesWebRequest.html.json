    {
      "source": "true if the request does not require further processing.",
      "translation": "如果请求不需要进一步处理，则为 true。",
      "count": 2
    },
    {
      "source": "the requested description as String",
      "translation": "请求的描述作为 String",
      "count": 2
    },
    {
      "source": "Requires JSF 2.0 or higher.",
      "translation": "需要 JSF 2.0 或更高版本。",
      "count": 1
    },
    {
      "source": "Check whether the requested resource has been modified given the\nsupplied <code>ETag</code> (entity tag), as determined by the application.",
      "translation": "检查应用程序根据提供的 `<code>ETag`（实体标签）判断请求的资源是否已修改。",
      "count": 1
    },
    {
      "source": "Check whether the requested resource has been modified given the\nsupplied <code>ETag</code> (entity tag) and last-modified timestamp,\nas determined by the application.",
      "translation": "检查应用程序确定的由提供的 `<code>ETag`（实体标签）和最后修改时间戳指示的所请求资源是否已修改。",
      "count": 1
    },
    {
      "source": "Return the request header of the given name, or <code>null</code> if none.",
      "translation": "返回给定名称的请求头，如果没有则返回<code>null</code>。",
      "count": 1
    },
    {
