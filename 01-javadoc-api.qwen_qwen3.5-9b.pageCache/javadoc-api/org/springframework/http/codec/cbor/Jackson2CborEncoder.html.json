      "source": "<code><a href=\"../json/AbstractJackson2Encoder.html#encode(org.reactivestreams.Publisher,org.springframework.core.io.buffer.DataBufferFactory,org.springframework.core.ResolvableType,org.springframework.util.MimeType,java.util.Map)\">encode</a></code> in class <code><a href=\"../json/AbstractJackson2Encoder.html\" title=\"class in org.springframework.http.codec.json\">AbstractJackson2Encoder</a></code>",
