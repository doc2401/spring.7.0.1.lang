  "items": [
    {
      "source": "Create a list of <a href=\"TypeReference.html\" title=\"interface in org.springframework.aot.hint\"><code>type references</code></a> mapped by the specified\ntypes.",
      "translation": "创建按指定类型映射的<a href=\"TypeReference.html\" title=\"interface in org.springframework.aot.hint\"><code>类型引用</code></a>列表。",
      "count": 3
    },
    {
      "source": "Create an instance based on the specified class name.\nThe format of the class name must follow <a class=\"external-link\" href=\"https://docs.oracle.com/en/java/javase/17/docs/api/java.base/java/lang/Class.html#getName()\" title=\"class or interface in java.lang\">Class.getName()</a>,\nin particular inner classes should be separated by a <code>$</code>.",
      "translation": "根据指定的类名创建实例。\n类名的格式必须遵循<a class=\"external-link\" href=\"https://docs.oracle.com/en/java/javase/17/docs/api/java.base/java/lang/Class.html#getName()\" title=\"class or interface in java.lang\">Class.getName()</a>，特别是内部类之间应使用<code>$</code>分隔。",
      "count": 2
    },
    {
      "source": "Return the <a class=\"external-link\" href=\"https://docs.oracle.com/en/java/javase/17/docs/api/java.base/java/lang/Class.html#getCanonicalName()\" title=\"class or interface in java.lang\">canonical name</a> of this\ntype reference.",
      "translation": "返回此类型引用的<a class=\"external-link\" href=\"https://docs.oracle.com/en/java/javase/17/docs/api/java.base/java/lang/Class.html#getCanonicalName()\" title=\"class or interface in java.lang\">canonical name</a>。",
      "count": 2
    },
    {
      "source": "Return the enclosing type reference, or <code>null</code> if this type reference\ndoes not have an enclosing type.",
      "translation": "返回外围类型引用，如果此类型引用没有外围类型，则返回 `<code>null</code>`。",
      "count": 2
    },
    {
      "source": "Return the <a class=\"external-link\" href=\"https://docs.oracle.com/en/java/javase/17/docs/api/java.base/java/lang/Class.html#getSimpleName()\" title=\"class or interface in java.lang\">simple name</a> of this type\nreference.",
      "translation": "返回此类型引用的<a class=\"external-link\" href=\"https://docs.oracle.com/en/java/javase/17/docs/api/java.base/java/lang/Class.html#getSimpleName()\" title=\"class or interface in java.lang\">简单名称</a>。",
      "count": 2
    },
    {
      "source": "Return the fully qualified name of this type reference.",
      "translation": "返回该类型引用的完全限定名称。",
      "count": 2
    },
    {
      "source": "Return the package name of this type.",
      "translation": "返回此类型的包名。",
      "count": 2
    },
    {
      "source": "Create an instance based on the specified type.",
      "translation": "根据指定的类型创建实例。",
      "count": 2
    },
    {
      "source": "<code><a class=\"external-link\" href=\"https://docs.oracle.com/en/java/javase/17/docs/api/java.base/java/lang/IllegalArgumentException.html\" title=\"class or interface in java.lang\">IllegalArgumentException</a></code> - if the specified type <a class=\"external-link\" href=\"https://docs.oracle.com/en/java/javase/17/docs/api/java.base/java/lang/Class.html#getCanonicalName()\" title=\"class or interface in java.lang\">canonical name</a> is <code>null</code>",
      "translation": "<code><a class=\"external-link\" href=\"https://docs.oracle.com/en/java/javase/17/docs/api/java.base/java/lang/IllegalArgumentException.html\" title=\"class or interface in java.lang\">IllegalArgumentException</a></code> - 如果指定的类型 <a class=\"external-link\" href=\"https://docs.oracle.com/en/java/javase/17/docs/api/java.base/java/lang/Class.html#getCanonicalName()\" title=\"class or interface in java.lang\">规范名称</a> 为 <code>null</code>",
      "count": 2
    },
    {
