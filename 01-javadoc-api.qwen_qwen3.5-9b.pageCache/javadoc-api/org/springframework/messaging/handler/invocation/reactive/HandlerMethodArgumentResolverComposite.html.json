    {
      "source": "Add the given <a href=\"HandlerMethodArgumentResolver.html\" title=\"interface in org.springframework.messaging.handler.invocation.reactive\"><code>HandlerMethodArgumentResolver</code></a>.",
      "translation": "添加给定的<a href=\"HandlerMethodArgumentResolver.html\" title=\"interface in org.springframework.messaging.handler.invocation.reactive\"><code>HandlerMethodArgumentResolver</code></a>。",
      "count": 3
