      "count": 2
    },
    {
      "source": "Create a new SimpleInstrumentableClassLoader for the given ClassLoader.",
      "translation": "为给定的 ClassLoader 创建一个新的 SimpleInstrumentableClassLoader。",
      "count": 2
    },
    {
      "source": "<code><a href=\"../../core/OverridingClassLoader.html#transformIfNecessary(java.lang.String,byte%5B%5D)\">transformIfNecessary</a></code> in class <code><a href=\"../../core/OverridingClassLoader.html\" title=\"class in org.springframework.core\">OverridingClassLoader</a></code>",
