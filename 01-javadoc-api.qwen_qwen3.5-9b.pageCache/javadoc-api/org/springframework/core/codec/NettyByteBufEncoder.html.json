    {
      "source": "<span class=\"description-from-type-label\">Description copied from interface: <code><a href=\"Encoder.html#encodeValue(T,org.springframework.core.io.buffer.DataBufferFactory,org.springframework.core.ResolvableType,org.springframework.util.MimeType,java.util.Map)\">Encoder</a></code></span>",
      "translation": "<span class=\"description-from-type-label\">描述从接口复制：<code><a href=\"Encoder.html#encodeValue(T,org.springframework.core.io.buffer.DataBufferFactory,org.springframework.core.ResolvableType,org.springframework.util.MimeType,java.util.Map)\">Encoder</a></code></span>",
      "count": 1
